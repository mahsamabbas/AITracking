{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@techlio/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-audit",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/web && NEXT_DIST_DIR=.next-dev npx next dev -p 3000"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@techlio/api",
        "run",
        "dev"
      ],
      "port": 3001
    }
  ]
}