{
  "name": "techlio-ai-activity",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm dev:stack",
    "dev:stack": "pnpm --parallel --filter @techlio/api --filter @techlio/web --filter @techlio/connector run dev",
    "dev:local": "pnpm --parallel --filter @techlio/web --filter @techlio/connector run dev",
    "dev:connector": "pnpm --filter @techlio/connector run dev",
    "connector:bundle": "node scripts/build-connector-bundle.mjs",
    "connector:pack": "node scripts/pack-connector.mjs",
    "connector:install-macos": "bash apps/web/public/install-connector-macos.sh",
    "connector:install-windows": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/web/public/install-connector-windows.ps1",
    "dev:worker": "pnpm --filter @techlio/worker run dev",
    "dev:stop": "sh -c 'for p in 3000 3001 9477; do lsof -ti :$p | xargs kill -9 2>/dev/null; done; echo Ports 3000, 3001, 9477 cleared'",
    "test": "turbo run test && pnpm --filter @techlio/e2e test",
    "lint": "turbo run lint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:prod": "bash scripts/migrate-prod.sh",
    "db:migrate:check": "node scripts/migrate.mjs --check",
    "db:seed": "pnpm --filter @techlio/server-core run build && TECHLIO_DEV_MODE=1 pnpm --filter @techlio/api exec tsx src/scripts/seed.ts",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "env:restore": "bash scripts/restore-env-from-vercel.sh",
    "env:check": "node scripts/check-env-files.mjs",
    "deploy:all": "bash scripts/deploy-all.sh",
    "deploy:all:connector": "bash scripts/deploy-all.sh --with-connector",
    "admin:create": "pnpm --filter @techlio/server-core run build && pnpm --filter @techlio/api exec tsx src/scripts/create-admin.ts",
    "admin:create:prod": "bash scripts/admin-create-prod.sh",
    "bootstrap:prod:access": "bash scripts/bootstrap-prod-access.sh",
    "env:push-supabase-vercel": "bash scripts/push-supabase-vercel-env.sh",
    "env:push-vercel": "bash scripts/push-api-env-to-vercel.sh",
    "db:migrate:check:prod": "node scripts/migrate.mjs --check --production",
    "db:retention": "pnpm --filter @techlio/server-core run build && pnpm --filter @techlio/api exec tsx src/scripts/retention.ts",
    "db:retention:prod": "bash scripts/retention-prod.sh",
    "db:purge-demo": "node scripts/purge-demo-data.mjs",
    "db:switch-supabase": "bash scripts/switch-production-to-supabase.sh",
    "prepare": "husky",
    "commits:sync": "node scripts/techlio-sync-commits.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "pg": "^8.13.1"
  }
}
