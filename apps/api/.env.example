# Production API project on Vercel: tracking-app-api → https://tracking-app-api-three.vercel.app
# Neon sets DATABASE_URL / POSTGRES_URL when linked in Vercel.
# Local development uses the Docker Postgres (docker compose up -d postgres) —
# never pull production values into apps/api/.env.local.

DATABASE_URL=
# Required outside dev mode: random, >= 32 characters (openssl rand -hex 32).
# The API refuses to start with a missing or placeholder secret.
JWT_SECRET=
SKIP_REDIS=1
ORG_TIMEZONE=Asia/Karachi
NODE_ENV=production

# Comma-separated dashboard origins connectors should accept (browser Origin header).
# Example for team techlio1: https://ai-tracking.vercel.app,https://ai-tracking-*-techlio1.vercel.app
# DASHBOARD_ORIGINS=

# Local development only. Enables demo portal users, the shared dev device
# token, and header auth. Refused on Vercel/Render/NODE_ENV=production.
# `pnpm dev` sets it for you; never set it in a hosted environment.
# TECHLIO_DEV_MODE=1

# Tier B pullers (apps/worker). Keys are organisation-wide; if the database
# holds more than one organisation, TECHLIO_PULL_ORG_ID says which one owns them.
# TECHLIO_PULL_ORG_ID=

# Cursor Team Admin API, read by apps/worker only (daily request counts per
# person, attributed by matching Cursor email to the employee email).
# CURSOR_API_KEY=
# GitHub Copilot daily user report (logins must be mapped in employee_provider_identities).
# GITHUB_TOKEN=
# GITHUB_ORG=
# Optional plan limits shown on employee AI cards. No limits exist unless set here
# or in organizations.ai_plan_limits, e.g. {"cursor":{"monthlyRequestBudget":500}}
# TECHLIO_DEFAULT_AI_PLAN_LIMITS=
