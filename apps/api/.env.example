# Production API project on Vercel: tracking-app-api → https://tracking-app-api-three.vercel.app
# Neon sets DATABASE_URL / POSTGRES_URL when linked in Vercel; for local API dev, copy from:
#   cd .vercel-api && vercel env pull ../apps/api/.env.local --environment=production

DATABASE_URL=
JWT_SECRET=
ALLOW_DEV_HEADER_AUTH=0
SKIP_REDIS=1
ORG_TIMEZONE=UTC
NODE_ENV=production

# Optional: Cursor Team Admin API — monthly billing-style usage on employee pages (also used by apps/worker).
# CURSOR_API_KEY=
