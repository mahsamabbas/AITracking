{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "cd ../.. && pnpm --filter \"@techlio/api...\" build && node scripts/migrate.mjs --on-deploy",
  "crons": [
    {
      "path": "/v1/maintenance/retention",
      "schedule": "30 21 * * *"
    }
  ]
}
